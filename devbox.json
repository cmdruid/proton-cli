{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": {
    "actionlint":     "latest",
    "bun":            "latest",
    "charm-freeze":   "latest",
    "gcc":            "latest",
    "git":            "latest",
    "go":             "latest",
    "golangci-lint":  "latest",
    "gopls":          "latest",
    "goreleaser":     "latest",
    "jetbrains-mono": "latest",
    "jq":             "latest",
    "just":           "latest",
    "nixfmt":         "latest",
    "pkg-config":     "latest",
    "protobuf":       "latest",
    "protoc-gen-go":  "latest",
    "resvg":          "latest",
    "shellcheck":     "latest",
    "webkitgtk_4_1": {
      "version":   "latest",
      "outputs":   ["out", "dev"],
      "platforms": ["x86_64-linux"]
    }
  },
  "env": {
    "CGO_ENABLED":                "0",
    "PKG_CONFIG_PATH_FOR_TARGET": "$DEVBOX_PROJECT_ROOT/tools/pkgconfig:$PKG_CONFIG_PATH_FOR_TARGET"
  },
  "shell": {
    "init_hook": [
      "if [ -f .env ]; then set -a; . ./.env; set +a; fi"
    ]
  }
}
