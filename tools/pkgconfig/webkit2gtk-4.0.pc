# Shim: maps the legacy pkg-config name `webkit2gtk-4.0` to `webkit2gtk-4.1`.
#
# Why: `github.com/webview/webview_go` hardcodes `pkg-config: webkit2gtk-4.0`
# in its cgo directive, but webkitgtk-4.0 in current nixpkgs pulls libsoup-2.74
# which is marked insecure. The 4.0 and 4.1 C ABIs are source-compatible for
# everything webview.h uses (the difference is sandbox-on-by-default, not API).
#
# This shim resolves `webkit2gtk-4.0` → `webkit2gtk-4.1`, so the cgo build
# links against the secure 4.1 lib. Runtime: webview.h dlopens libwebkit2gtk-4.1
# first anyway.

Name: webkit2gtk-4.0
Description: Shim aliasing webkit2gtk-4.0 to webkit2gtk-4.1
Version: 2.52.3
Requires: webkit2gtk-4.1
